{
  "name": "notewize",
  "productName": "NoteWize",
  "version": "0.1.0",
  "description": "A minimal, pure-Markdown note-taking app for Linux.",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "bun run build:electron && bun run build:renderer",
    "start": "bun run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "check:electron": "tsc -p tsconfig.electron.json --noEmit",
    "check:renderer": "svelte-check --tsconfig ./tsconfig.json",
    "check": "bun run check:electron && bun run check:renderer",
    "package:appimage": "bun run build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "carta-md": "^4.11.5",
    "dompurify": "^3.5.0",
    "mermaid": "^12.3.0"
  },
  "author": "NoteWize",
  "homepage": "https://github.com/dragonwize/notewize",
  "build": {
    "appId": "net.dragonwize.notewize",
    "productName": "NoteWize",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "synopsis": "Minimal Markdown note-taking",
      "mimeTypes": [
        "text/markdown"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "NoteWize",
          "GenericName": "Markdown Notes"
        }
      },
      "artifactName": "NoteWize-${version}-${arch}.AppImage",
      "syncDesktopName": true
    }
  },
  "desktopName": "notewize.desktop"
}
